  "urdf": "g1_d.urdf",
  "base_link": "torso_link",
  "num_motors": 29,
  "cameras": {
    "head": {
      "label": "头部双目（teleimager）",
      "type": "teleimager",
      "host": "192.168.123.164",
      "teleimager_path": "/home/robot/yx/teleimager_src_copy",
      "link": "d435_link",
      "link_note": "URDF 的 d435_link 是头部双目的标称安装位（ROS 机体系，下俯约 47.6°）；有手眼标定时三维按标定结果画"
    }
  },
  "lidars": {
    "head": {
      "label": "头部 MID-360（宇树 DDS 转发）",
      "type": "unitree_dds",
      "topic": "rt/utlidar/cloud_livox_mid360",
      "link": "mid360_link",
      "mount_rpy": [3.141592653589793, 0.0, 0.0],
      "mount_note": "头部与 G1 相同，安装位置照搬 G1 的 mid360_joint，姿态只保留倒装（宇树转发的点云已补偿 URDF 的 2.93° 俯仰，同 G1）。"
    }
  },
  "torso_imu": {
    "topic": "rt/secondary_imu",
    "mount_rpy": [0.0, 0.0, 0.0],
    "max_tilt_deg": 20.0,
    "gravity_default": false,
    "display_pitch_joint": "Yaw_Joint",
    "note": "宇树躯干 IMU（unitree_hg IMUState，约 1 kHz），坐标系与 torso_link 一致（同 G1 URDF 的 imu_in_torso，rpy 0）。2026-11-11 实测：四元数给的躯干倾角与雷达拟合地面差约 0.15°；原始加速度计有约 2° 零偏，不用。"
  },
  "control": {
    "backend": "unitree_lowcmd",
